# Coalesce Quality API credentials. Create them under Settings → API in your
# workspace and set them in your own overlay's agent.env, not here.
#
# Deliberately empty. An empty value falls through to the environment, so a
# deployment whose overlay still sets the older SYNQ_CLIENT_ID / SYNQ_CLIENT_SECRET
# keeps working; a real value here would shadow it.
QUALITY_CLIENT_ID=
QUALITY_CLIENT_SECRET=
